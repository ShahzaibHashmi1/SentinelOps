        {
          "refId": "A",
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{service=\"$service\"}[1m])) / (max(container_spec_cpu_quota{service=\"$service\"}) / max(container_spec_cpu_period{service=\"$service\"}))",
