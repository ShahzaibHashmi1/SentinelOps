    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "gateway,orders,payments,inventory",
        "current": {
          "selected": true,
          "text": "gateway",
          "value": "gateway"
        },
        "options": [
          {
            "selected": true,
            "text": "gateway",
            "value": "gateway"
          },
          {
            "selected": false,
            "text": "orders",
            "value": "orders"
