# SentinelOps environment. Copy this file to .env (git-ignored) before running:
#   copy .env.example .env
# Never commit .env. Values below are local-development placeholders.

# --- postgres (used by the postgres container and to build DATABASE_URL) ---
POSTGRES_USER=shop
# Use URL-safe characters only (letters, digits, - _ .) because it is placed inside DATABASE_URL.
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=shop

# --- shared by all app services (passed through docker-compose.yml) ---
# APP_VERSION is a Docker build arg that becomes an env var, shown in /health, app_info and every log line.
APP_VERSION=1.0.0
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=2.0
HTTP_MAX_CONNECTIONS=50
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=2.0
# Gateway only: kept above HTTP_TIMEOUT_SECONDS so backend error answers reach the client.
GATEWAY_HTTP_TIMEOUT_SECONDS=3.0

# --- payments service (added in CP2) ---
PAYMENT_DELAY_MS_MIN=20
PAYMENT_DELAY_MS_MAX=80

# --- load test, compose profile "load" (added in CP4) ---
USERS=20
SPAWN_RATE=2
DURATION=5m

# --- observability stack, compose profile "observability" (added in M2 CP4) ---
# Grafana admin login (user: admin). Placeholder for local development only; avoid "$" in the value.
# If this variable is missing, docker-compose.yml falls back to change_me_dev_only.
GRAFANA_ADMIN_PASSWORD=change_me_dev_only

# --- set per service inside docker-compose.yml (not here) ---
# SERVICE_NAME  DATABASE_URL  REDIS_URL  ORDERS_URL  PAYMENTS_URL  INVENTORY_URL
